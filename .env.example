# for deployment
DEPLOYER_PRIVATE_KEY=
DEPLOYER_WALLET_ADDRESS=
RPC_URL=

# for verification on explorers
ETHERSCAN_API_KEY=

# for Tenderly Virtual TestNets
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_NAME=
TENDERLY_PROJECT_NAME=
HUNDRED_ETH=100000000000000000000

# =============================================================================
# MAINNET BRIDGE DEPLOYMENT
# See .env.mainnet.keystore.example for the full template used by
# scripts/mainnet/deploy_keystore.sh (copy to .env.mainnet).
# =============================================================================
#
# KEYSTORE_ACCOUNT=                            # encrypted Foundry keystore name
# DEPLOYER_ADDRESS=                            # temporary deployer EOA
# MAINNET_RPC_URL=                             # must resolve to chainId 1
# ETHERSCAN_API_KEY=                           # used for --verify
# MULTISIG_ADDRESS=                            # optional; defaults to production Safe
# FEE_RECIPIENT_ADDRESS=                       # optional; defaults to multisig
# G_TOKEN_ADDRESS=0x9C7BEBa8F6eF6643aBd725e45a4E8387eF260649
# BASE_FEE_WEI=50000000000000
# FEE_PER_BYTE_WEI=2343750000000

